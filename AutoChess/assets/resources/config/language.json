    "fetters_1_introductory": {
        "id": "fetters_1_introductory",
        "chinese": "主人，我搞卫生的时候又找到一枚金币，给你"
    },
    "fetters_2_introductory": {
        "id": "fetters_2_introductory",
        "chinese": "未战而狂者为狂战士，战斗，爽！"
    },
    "fetters_3_introductory": {
        "id": "fetters_3_introductory",
        "chinese": "海盗们从不甘心死亡，当他们在战场上阵亡时，他们会召唤炮火攻击所有敌人"
    },
    "fetters_4_introductory": {
        "id": "fetters_4_introductory",
        "chinese": "高端的治疗就是满血也能为你继续加血"
    },
    "fetters_5_introductory": {
        "id": "fetters_5_introductory",
        "chinese": "观星的术士们试图利用虚空的力量，而虚空也甘之如饴"
    },
    "fetters_6_introductory": {
        "id": "fetters_6_introductory",
        "chinese": "机械师角色会每回合修建一个最终战斗机甲，机甲在修建数4/20/40时会获得不同的效果（机甲会在全部机甲羁绊角色阵亡后出现）"
    },
    "fetters_7_introductory": {
        "id": "fetters_7_introductory",
        "chinese": "健身可能有效果，但健身有效果不太可能"
    },
    "fetters_8_introductory": {
        "id": "fetters_8_introductory",
        "chinese": "虽然只会做生菜沙拉，但已然是世界上少有的高级厨师"
    },
    "fetters_9_introductory": {
        "id": "fetters_9_introductory",
        "chinese": "巫师们会从他人的苦难中汲取力量"
    },
    "fetters_10_introductory": {
        "id": "fetters_10_introductory",
        "chinese": "祭祀们从神祗那里获得力量，每次回合开始时会强化一名随机角色"
    },
    "fetters_11_introductory": {
        "id": "fetters_11_introductory",
        "chinese": "魔法？没那么夸张，仅仅是一场魔术罢了"
    },
    "fetters_12_introductory": {
        "id": "fetters_12_introductory",
        "chinese": "中间人售卖战争的结果，并从中获益"
    },
    "fetters_13_introductory": {
        "id": "fetters_13_introductory",
        "chinese": "圣骑士角色所受到的伤害，会由全部圣骑士平均进行分摊"
    },
    "fetters_14_introductory": {
        "id": "fetters_14_introductory",
        "chinese": "万一下回合就刷出来那把神器了呢？"
    },
    "fetters_1_text": {
        "id": "fetters_1_text",
        "chinese": "2：每位家仆角色获得1金币\n3：每位家仆角色获得2金币"
    },
    "fetters_2_text": {
        "id": "fetters_2_text",
        "chinese": "2：攻击力提升3\n3：攻击力提升5\n4：攻击力提升5，生命值提升1"
    },
    "fetters_3_text": {
        "id": "fetters_3_text",
        "chinese": "2：对所有角色造成1伤害\n3：对所有角色造成2伤害\n4：对所有角色造成3伤害\n5：对所有角色造成5伤害"
    },
    "fetters_4_text": {
        "id": "fetters_4_text",
        "chinese": "2：随机一名友方单位增加5生命值\n3：随机两名友方单位增加5生命值"
    },
    "fetters_5_text": {
        "id": "fetters_5_text",
        "chinese": "2：召唤一个1/1的虚空虫\n3：召唤一个3/3的虚空虫\n4：召唤一个5/5的虚空虫"
    },
    "fetters_6_text": {
        "id": "fetters_6_text",
        "chinese": "2：增加1修建值\n3：增加2修建值\n5：增加3修建值\n6：增加4修建值"
    },
    "fetters_7_text": {
        "id": "fetters_7_text",
        "chinese": "2：额外提升1生命值\n3：额外提升1生命值和1攻击力"
    },
    "fetters_8_text": {
        "id": "fetters_8_text",
        "chinese": "2：使商店刷新免费沙拉"
    },
    "fetters_9_text": {
        "id": "fetters_9_text",
        "chinese": "2：巫师角色提升1/1的数值\n3：巫师角色提升1/2的数值\n4：巫师角色提升2/2的数值"
    },
    "fetters_10_text": {
        "id": "fetters_10_text",
        "chinese": "2：随机使一名角色+1生命值\n3：使一名角色+1/+1\n4：使一名角色+1/+2"
    },
    "fetters_11_text": {
        "id": "fetters_11_text",
        "chinese": "2：随机调换对方三名角色的属性（攻击/生命）\n4：魔术师所有棋子的血量等于血量最高的伙伴（可以是非魔术师）的属性\n6：将你的第一个棋子与对方第一个棋子交换"
    },
    "fetters_12_text": {
        "id": "fetters_12_text",
        "chinese": "2：若上一场战斗失败，获得6金币\n3：若上一场战斗失败，获得10金币\n4：若上一场战斗失败，获得15金币"
    },
    "fetters_13_text": {
        "id": "fetters_13_text",
        "chinese": "2：所受伤害-1\n3：所受伤害-2"
    },
    "fetters_14_text": {
        "id": "fetters_14_text",
        "chinese": "3：商店将会展示一把铁匠武器"
    },
